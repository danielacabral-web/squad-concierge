# Instagram Publisher — Credenciais
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no repositório

# Chave da API do imgbb (upload de imagens)
# Obtenha em: https://api.imgbb.com/
IMGBB_API_KEY=

# Token de acesso do Instagram Business (longa duração — 60 dias)
# Instruções completas em: skills/instagram-publisher/SKILL.md
INSTAGRAM_ACCESS_TOKEN=

# ID do usuário da conta Instagram Business @concierge.ia
# Instruções completas em: skills/instagram-publisher/SKILL.md
INSTAGRAM_USER_ID=
